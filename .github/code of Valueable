<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>I Love You ❤️</title>
    <style>
        body {
            background-color: #ffdde1;
            text-align: center;
            font-family: 'Arial', sans-serif;
            margin: 0;
            padding: 0;
        }

        .container {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
        }

        h1 {
            font-size: 50px;
            color: #ff4b5c;
        }

        .heart {
            font-size: 100px;
            animation: heartbeat 1s infinite;
            color: red;
        }

        @keyframes heartbeat {
            0% { transform: scale(1); }
            50% { transform: scale(1.2); }
            100% { transform: scale(1); }
        }

        button {
            background-color: #ff4b5c;
            color: white;
            border: none;
            padding: 15px 30px;
            font-size: 18px;
            cursor: pointer;
            border-radius: 10px;
            margin-top: 20px;
        }

        button:hover {
            background-color: #d93a47;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>I Love You ❤️</h1>
        <div class="heart">💖</div>
        <button onclick="showLove()">Click for More Love</button>
        <p id="message" style="font-size: 20px; color: #ff4b5c; display: none;"></p>
    </div>

    <script>
        function showLove() {
            document.getElementById("message").innerHTML = "You are my heart, my soul, my everything! 💕";
            document.getElementById("message").style.display = "block";
        }
    </script>
</body>
</html>
